  },
  {
   "id": "seq",
   "type": "make_sequences",
   "params": {},
   "ui": {
    "x": 2400,
    "y": 0
   },
   "note": "HR from the chunk, LR from the picked chain."
  },
  {
   "id": "blank",
   "type": "reject_blank",
   "params": {},
   "ui": {
    "x": 2700,
    "y": 0
   },
   "note": "Drops fades and black frames."
