{
 "version": 1,
 "seed": 10,
 "name": "10. Mixed sources: web, DVD and tape",
 "description": "Each chunk gets one whole chain: web (soft scaling, grain, H.264), DVD (sharpened, MPEG-2) or tape (colour bleed, ghosts, grain, MPEG-2). A single chain with per-node chances would mix them into hybrids no real video has. The pick is in the manifest.",
 "summary": "One coherent damage chain per chunk",
 "nodes": [
