    "x": 1800,
    "y": 150
   }
  },
  {
   "id": "vcr_cap",
   "type": "ntsc_decode",
   "params": {},
   "note": "Captured.",
   "ui": {
    "x": 2100,
    "y": 150
   }
  },
  {
   "id": "tbc",
