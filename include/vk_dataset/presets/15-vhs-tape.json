{
 "version": 1,
 "seed": 10,
 "name": "15. VHS tape",
 "description": "LR goes through an analogue chain: encoded to NTSC composite, recorded to a VHS tape of a different grade per chunk (sometimes dubbed), played on a home VCR or an S-VHS deck with TBC, decoded and captured to MPEG-2. One tape feeds both decks; Random Branch runs only the one it picks. Best from HD sources, which Resample brings to SD size first.",
 "summary": "Simulated VHS recordings",
 "nodes": [
  {
   "id": "src",
   "type": "load_video",
   "params": {},
   "note": "Choose your high-quality video.",
   "ui": {
    "x": 0,
    "y": 0
   }
  },
  {
   "id": "chunks",
   "type": "chunk",
   "params": {},
   "note": "One chunk per scene.",
   "ui": {
    "x": 300,
    "y": 0
   }
  },
  {
   "id": "down",
   "type": "resample",
   "params": {
    "size": "720x480"
   },
   "note": "Down to an SD frame.",
   "ui": {
    "x": 600,
    "y": 300
   }
  },
  {
   "id": "enc",
   "type": "ntsc_encode",
   "params": {},
