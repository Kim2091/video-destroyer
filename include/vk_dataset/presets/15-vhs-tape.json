   "ui": {
    "x": 2100,
    "y": 450
   }
  },
  {
   "id": "pick",
   "type": "random_branch",
   "params": {
    "weights": [
     0.6,
     0.4,
     0.0,
     0.0
    ]
   },
   "note": "60% VCR, 40% S-VHS deck.",
   "ui": {
    "x": 2400,
    "y": 300
   }
  },
  {
   "id": "comp",
   "type": "codec",
   "params": {
    "profile": "dvd_mpeg2",
    "quality": {
     "uniform": [
      0.2,
      0.9
     ]
    }
   },
   "note": "Captured to DVD-R style MPEG-2.",
   "ui": {
    "x": 2700,
    "y": 300
   }
  },
  {
   "id": "seq",
