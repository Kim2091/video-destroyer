{
 "version": 1,
 "seed": 17,
 "name": "17. Shared and derived settings",
 "description": "Value nodes driving settings by wire: one random profile shared by an upload and its re-encode, and a re-encode quality worked out from the upload's quality times a random factor below 1, so the second encode is always the worse one.",
 "summary": "One pick shared by two nodes, one setting derived from another",
 "nodes": [
  {
   "id": "src",
   "type": "load_video",
   "params": {},
   "note": "Choose your high-quality video (or a folder of videos).",
   "ui": {
    "x": 0,
    "y": 0
   }
  },
  {
   "id": "chunks",
   "type": "chunk",
   "params": {},
   "note": "One chunk per scene, each with its own random settings.",
   "ui": {
    "x": 300,
    "y": 0
   }
  },
  {
   "id": "down",
   "type": "scale_to_model",
   "params": {
    "scale": 2
   },
   "note": "Half size, for a 2x model.",
   "ui": {
    "x": 600,
    "y": 300
   }
  },
  {
   "id": "profile",
   "type": "random_pick",
   "params": {
    "options": {
     "choice": [
      "web_h264",
      "web_h265"
     ],
     "weights": [
      3,
      1
     ]
    }
   },
   "note": "One profile per chunk, shared by both encodes: H.264 three times in four.",
   "ui": {
    "x": 600,
    "y": -300
   },
   "label": "Profile"
  },
  {
   "id": "quality",
   "type": "random_number",
   "params": {
    "low": 0.3,
    "high": 1.0
   },
   "note": "The upload's quality, drawn per chunk.",
   "ui": {
    "x": 600,
    "y": -150
   },
   "label": "Upload quality"
  },
  {
   "id": "factor",
   "type": "random_number",
   "params": {
    "low": 0.6,
    "high": 0.95
   },
   "note": "How much quality the site's encode keeps.",
   "ui": {
    "x": 900,
    "y": -150
   },
   "label": "Quality kept"
  },
  {
   "id": "requality",
   "type": "math",
   "params": {
    "operation": "multiply"
   },
   "note": "Re-encode quality: the upload's times the factor.",
   "ui": {
    "x": 1200,
    "y": -150
   },
   "label": "Re-encode quality"
  },
  {
   "id": "comp",
   "type": "codec",
   "params": {},
   "note": "The upload, at the drawn profile and quality.",
   "ui": {
    "x": 900,
    "y": 300
   },
   "label": "Upload"
  },
  {
   "id": "reup",
   "type": "codec",
   "params": {
    "probability": 0.5
   },
   "note": "The site encodes it again, 50%: same profile, lower quality.",
   "ui": {
    "x": 1200,
    "y": 300
   },
   "label": "Re-encode"
  },
  {
   "id": "seq",
   "type": "make_sequences",
   "params": {},
   "note": "5-frame sequences; HR from the chunk, LR from the encodes.",
   "ui": {
    "x": 1500,
    "y": 0
   }
  },
  {
   "id": "out",
   "type": "write_dataset",
   "params": {
    "directory": ""
   },
   "note": "Pick an output folder.",
   "ui": {
    "x": 1800,
    "y": 0
   }
  }
 ],
 "edges": [
  {
   "from": "src.clip",
   "to": "chunks.clip"
  },
  {
   "from": "chunks.clip",
   "to": "down.clip"
  },
  {
   "from": "chunks.clip",
   "to": "down.hr"
  },
  {
   "from": "down.clip",
   "to": "comp.clip"
  },
  {
   "from": "comp.clip",
   "to": "reup.clip"
  },
  {
   "from": "chunks.clip",
   "to": "seq.hr"
  },
  {
   "from": "reup.clip",
   "to": "seq.lr"
  },
  {
   "from": "seq.sequences",
   "to": "out.sequences"
  },
  {
   "from": "profile.value",
   "to": "comp.param:profile"
  },
  {
   "from": "profile.value",
   "to": "reup.param:profile"
  },
  {
   "from": "quality.value",
   "to": "comp.param:quality"
  },
  {
   "from": "quality.value",
   "to": "requality.param:a"
  },
  {
   "from": "factor.value",
   "to": "requality.param:b"
  },
  {
   "from": "requality.value",
   "to": "reup.param:quality"
  }
 ]
}