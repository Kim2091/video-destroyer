    "y": 0
   },
   "note": "The dataset folder (with hr/ and lr/)."
  },
  {
   "id": "denoise",
   "type": "denoise_hr",
   "params": {
    "model": "",
    "tile_width": 512,
    "tile_height": 512,
    "overlap": 32
   },
   "enabled": false,
   "ui": {
    "x": 300,
    "y": 0
   },
   "note": "Off."
  },
  {
   "id": "darken",
   "type": "fast_line_darken",
   "enabled": false,
   "ui": {
    "x": 600,
    "y": 0
   },
   "note": "Off."
  },
  {
