    "x": 1800,
    "y": 0
   },
   "note": "Off."
  },
  {
   "id": "anicc",
   "type": "anicc",
   "params": {
    "model": ""
   },
   "enabled": false,
   "ui": {
    "x": 2100,
    "y": 0
   },
   "note": "Off."
  },
  {
   "id": "out",
   "type": "write_processed",
   "params": {
    "directory": ""
   },
   "ui": {
    "x": 2400,
    "y": 0
   },
   "note": "Writes lr_p/ beside lr/."
  }
 ],
 "edges": [
  {
   "from": "src.hr",
   "to": "denoise.clip"
  },
  {
   "from": "denoise.clip",
   "to": "darken.clip"
  },
  {
   "from": "darken.clip",
   "to": "dehalo.clip"
  },
  {
   "from": "dehalo.clip",
   "to": "prism.clip"
  },
