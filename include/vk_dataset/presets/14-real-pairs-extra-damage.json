    "max_tiles": 5,
    "min_detail": 0.0015,
    "edge_margin": 8,
    "motion_bias": 1.0
   },
   "ui": {
    "x": 2700,
    "y": 0
   },
   "note": "Best 5 crops: 2 plus 3 spares."
  },
  {
   "id": "aligned",
   "type": "reject_misaligned",
   "params": {
    "min_alignment_score": 0.7,
