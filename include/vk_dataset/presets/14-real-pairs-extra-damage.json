   },
   "ui": {
    "x": 3000,
    "y": 0
   },
   "note": "Drops bad syncs and warps; keeps 2."
  },
  {
   "id": "out",
   "type": "write_dataset",
   "params": {
    "directory": "",
    "folders": {
